<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageReference Include="Moq" Version="4.20.70" />
    <PackageReference Include="NUnit" Version="4.1.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" PrivateAssets="all" />
    <ProjectReference Include="../Nop.Plugin.Api/Nop.Plugin.Api.csproj" />
    <ProjectReference Include="../ClientApp/ClientApp.csproj" />
  </ItemGroup>

  <!-- Keep historical MVC and inactive fixtures outside the .NET 10 test build. -->
  <ItemGroup>
    <Compile Remove="ControllersTests/**/*.cs" />
    <Compile Remove="ModelBinderTests/**/*.cs" />
    <Compile Remove="MappingTests/**/*.cs" />
    <Compile Remove="Helpers/ActionResultExecutor.cs" />
    <Compile Remove="ServicesTests/CountryApiServiceTests.cs" />
    <Compile Remove="ServicesTests/StateProvinceApiServiceTests.cs" />
    <Compile Remove="ServicesTests/Customers/CustomerApiServiceTests.cs" />
  </ItemGroup>
</Project>
